{
  "name": "unx-manager",
  "version": "1.0.1",
  "description": "Install, configure and maintain Untitled Project X for Final Fantasy X/X-2 HD Remaster.",
  "author": "UnX Community",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "main/main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "smoke": "node ../scripts/smoke-launcher.cjs",
    "icons": "node ../scripts/create-launcher-icons.cjs",
    "prebuild:win": "npm run icons",
    "prebuild:linux": "npm run icons",
    "build:win": "electron-builder --win portable --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "adm-zip": "0.6.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "7zip-bin": "5.2.0",
    "sharp": "0.35.5",
    "png-to-ico": "3.0.2"
  },
  "build": {
    "appId": "io.github.adrigm.unx-manager",
    "productName": "UnX Manager",
    "copyright": "UnX Community. Original mod by Kaldaien and contributors.",
    "directories": { "output": "../artifacts/launcher", "buildResources": "assets" },
    "files": ["main/**/*", "preload/**/*", "renderer/**/*", "shared/**/*", "package.json"],
    "extraResources": [{ "from": "payload", "to": "payload" }, { "from": "assets/unx.png", "to": "unx.png" }, { "from": "../LICENSE", "to": "licenses/UnX-original-LICENSE.txt" }, { "from": "../AUTHORS", "to": "licenses/AUTHORS.txt" }, { "from": "assets/GPL-3.0.txt", "to": "licenses/GPL-3.0.txt" }],
    "asar": true,
    "win": { "target": ["portable"], "artifactName": "UnX-Manager-${version}-windows-${arch}.${ext}", "icon": "assets/unx.ico", "signExecutable": false },
    "portable": { "requestExecutionLevel": "user" },
    "linux": { "target": ["AppImage"], "category": "Game", "icon": "assets/unx.png", "artifactName": "UnX-Manager-${version}-linux-${arch}.${ext}", "desktop": { "entry": { "Name": "UnX Manager", "Comment": "Install and configure Untitled Project X" } } },
    "publish": null
  }
}
